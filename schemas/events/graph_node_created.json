{
  "event_type": "graph.node.created",
  "schema_version": 1,
  "partition_key": "user_id",
  "description": "Fired when a graph node is created",
  "required_payload_fields": ["node_id", "user_id", "type", "source_id"],
  "payload_properties": {
    "node_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the graph node"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "User who owns the node"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "habit",
        "learning_topic",
        "health_log",
        "database_record"
      ],
      "description": "Type of entity represented by the node"
    },
    "title": {
      "type": "string",
      "description": "Display name of the node"
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the original entity from source service"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the node"
    }
  }
}
