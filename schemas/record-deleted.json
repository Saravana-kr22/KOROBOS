{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "record.deleted Event",
  "description": "Published when a record is deleted",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "const": "record.deleted"
    },
    "source_service": {
      "type": "string",
      "const": "database-service"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was created"
    },
    "payload": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid",
          "description": "The ID of the deleted record"
        },
        "database_id": {
          "type": "string",
          "format": "uuid",
          "description": "The ID of the database that contained the record"
        },
        "user_id": {
          "type": "string",
          "format": "uuid",
          "description": "The ID of the user who deleted the record"
        }
      },
      "required": ["record_id", "database_id", "user_id"]
    }
  },
  "required": ["event_type", "source_service", "timestamp", "payload"]
}
