SEARCH_KEY=masterKey

# Object Storage
OBJECT_STORAGE_URL=http://localhost:9000
OBJECT_STORAGE_USER=rootuser
OBJECT_STORAGE_PASS=rootpassword

# Security
JWT_SECRET=dev_secret_key_change_in_prod
