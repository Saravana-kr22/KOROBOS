# Development Environment Variables
ENV=development

# Database
DATABASE_URL=postgresql://korobos:password@localhost:5432/korobos

# Cache
REDIS_URL=redis://localhost:6379/0

# Messaging
KAFKA_BROKER=localhost:9092

# Search
